# Secret env names at any context depth; only credential-free example templates are allowed.
.env
.env.*
*.env
*.env.*
.envrc
.envrc.*
*.envrc
*.envrc.*
**/.env
**/.env.*
**/*.env
**/*.env.*
**/.envrc
**/.envrc.*
**/*.envrc
**/*.envrc.*
!.env.example
!*.env.example
!**/.env.example
!**/*.env.example
.venv
venv
node_modules
dist
.git
.gitignore
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
*.egg-info
coverage
.DS_Store
*.log
tmp
results
*.sqlite3
