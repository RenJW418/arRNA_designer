# Copy to a separate operator-managed file and set real values before any run.
# Bare public DNS hostname only: no scheme, path or port; blank until confirmed.
LEAPER_DOMAIN=
# HTTP upstream reachable FROM the edge container. Example for an existing
# host service: http://host.docker.internal:8008 . Set explicitly after review.
LEAPER_HTTPS_UPSTREAM=
# Pin a reviewed Caddy 2 image digest for a reproducible production launch.
# This public tag is only the preparation default, not a verified digest.
LEAPER_CADDY_IMAGE=caddy:2-alpine
